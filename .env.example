# === Emby ===
# URL interna que usa el panel para hablar con la API de Emby
#   Desarrollo (Windows): http://187.124.208.99:8096
#   Producción (Ubuntu):  http://localhost:8096
EMBY_URL=http://187.124.208.99:8096

# API key de administrador de Emby (Panel de Emby -> Avanzado -> Claves de API)
EMBY_API_KEY=pon_aqui_tu_api_key

# URL que se muestra a los clientes finales como "datos de conexión".
# En producción normalmente es la URL pública del servidor, no localhost.
EMBY_PUBLIC_URL=http://187.124.208.99:8096

# === Más servidores Emby ===
# El servidor 1 es el de arriba (EMBY_URL, EMBY_API_KEY, EMBY_PUBLIC_URL).
# No hace falta repetirlo. El nombre visible se puede cambiar; si se omite, es "Servidor 1".
# EMBY_SERVER_1_NAME=Servidor 1
# EMBY_SERVER_1_PUBLIC_URL=
# EMBY_SERVER_1_API_KEY=
#
# Servidor 2 y los siguientes: URL interna, URL que ve el cliente, nombre y API key.
# Si EMBY_SERVER_N_API_KEY está vacío, se usa la misma clave que EMBY_API_KEY.
# Para un tercero, copia el bloque con 3. El número es el id (no hace falta que sean seguidos).
# La API key no se guarda en la base ni en el repo: solo en este .env.
EMBY_SERVER_2_NAME=Servidor 2
EMBY_SERVER_2_URL=http://175.110.121.37:8096
EMBY_SERVER_2_PUBLIC_URL=http://175.110.121.37:8096
EMBY_SERVER_2_API_KEY=

# === Panel ===
PORT=3000

# Cadena aleatoria larga para firmar las cookies de sesión.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esto_por_una_cadena_aleatoria_larga

# Ruta del fichero SQLite (relativa a la raíz del proyecto)
DB_PATH=./data/panel.sqlite

# === Caducidades ===
# Días tras la caducidad para borrar la cuenta de Emby definitivamente. 0 = nunca borrar.
DELETE_AFTER_DAYS=15

# Cada cuánto se revisan caducidades (formato cron de 5 campos).
# Cada 30 min recomendado: necesario para que las demos por horas corten a tiempo.
EXPIRY_CRON=*/30 * * * *

# Qué pasa en Emby al caducar una cuenta:
#   disable -> la cuenta se desactiva (no puede iniciar sesión); mensaje genérico de Emby
#   vitrina -> puede iniciar sesión, pero solo ve la biblioteca-cartel indicada abajo.
#              Crea antes en Emby una biblioteca vacía cuyo NOMBRE sea tu mensaje,
#              p. ej. "⚠ CUENTA CADUCADA · escríbenos" y ponlo aquí EXACTO.
#              Los activos ven todas las bibliotecas MENOS el cartel. Tras activar
#              este modo (o añadir bibliotecas nuevas en Emby) ejecuta una vez:
#              npm run sync-bibliotecas
EXPIRY_MODE=disable
EXPIRY_LIBRARY=

# === XUI.one ===
# URL del admin API, con el código de acceso y sin query. Ejemplo real:
#   https://149.62.187.37/qArcBQyi/
# El panel llama GET {XUI_API_URL}?api_key=...&action=...
# Déjalo vacío para usar el panel solo con Emby.
XUI_API_URL=
XUI_API_KEY=

# 1 = no verificar el certificado TLS, solo en las peticiones a XUI
# (el panel va por IP con certificado autofirmado). No afecta a Emby ni a Max Player.
# Quítalo cuando el certificado sea válido.
XUI_INSECURE_TLS=

# Opcional. Id del usuario XUI dueño de las líneas (member_id).
# Si se omite, la línea queda del usuario de la API key.
XUI_MEMBER_ID=

# Salidas de la línea (HLS, MPEG-TS, RTMP). Este XUI ignora el paquete y también
# ignora allowed_outputs y output_formats. El alta manda access_output[]=1&2&3.
# En cada edición, si get_line trae salidas se reenvían; si vienen vacías, estas.
# Vacío equivale a 1,2,3.
XUI_ALLOWED_OUTPUTS=1,2,3

# URL que ve el cliente de TotalFlix (Xtream / M3U). No es la URL de admin.
# Ejemplo: http://linea.totalflix.example:8080
XUI_PUBLIC_URL=

# Barrido por id cuando get_lines viene vacío. Nginx de este XUI responde 503
# si se piden unas 10 líneas a la vez, así que la concurrencia se queda en 4.
# Un 503, un 5xx o un corte se reintenta; si sigue fallando, la importación para.
# Un id ausente es {"status":"STATUS_FAILURE"} y se salta. Hay ~3500 líneas con
# ids por encima de 4700: el hueco de parada aguanta una racha larga de vacíos
# y el id máximo cubre ese rango. Si el barrido se queda corto, súbelos.
XUI_SCAN_CONCURRENCY=4
XUI_SCAN_MISS_GAP=2000
XUI_SCAN_MAX_ID=10000

# === Max Player ===
# API pública. Cabecera Api-Token. Spec en el panel del proveedor.
MAXPLAYER_API_URL=https://api.maxplayer.tv/v3/api/public
MAXPLAYER_API_KEY=
# domain_id del dominio asignado al proveedor. Obligatorio para crear usuarios
# y enganchar la playlist de la línea XUI.
MAXPLAYER_DOMAIN_ID=
# Opcional: crear los usuarios bajo este reseller de Max Player.
MAXPLAYER_RESELLER_ID=
# Servidores que alterna el botón Reparar. Si se dejan vacíos se usan estos ids.
MAXPLAYER_DOMAIN_PATO_ID=1788037663857452993
MAXPLAYER_DOMAIN_CISNE_ID=1761067741584705224

# === HotPlayer ===
# API de reseller. Cabecera Authorization: ApiKey <clave>.
# El panel solo lee el saldo y carga listas. No llama a /activate (gasta
# créditos: la app la paga el cliente) ni a /delete-playlists.
HOTPLAYER_API_URL=https://hotplayer.app/api/v1/reseller
HOTPLAYER_API_KEY=
# Dominio Xtream que se carga en la tele, formato HOST:PORT|USUARIO|PASSWORD.
HOTPLAYER_DOMAIN=cisnerojo.click
HOTPLAYER_PORT=80

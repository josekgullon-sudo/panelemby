<%- include('../partials/header', { title: 'Mi cuenta', nav: '' }) %>

<div class="client-hero">
  <div class="client-days <%= !account.expires_at ? '' : account.status !== 'active' ? 'is-expired' : days <= 7 ? 'is-warn' : '' %>">
    <div class="client-days-num"><%= !account.expires_at ? '—' : account.status === 'active' ? Math.max(days, 0) : 0 %></div>
    <div class="client-days-label"><%= account.expires_at ? 'días restantes' : 'sin caducidad' %></div>
  </div>
  <div class="client-summary">
    <h2>Hola, <%= account.username %></h2>
    <% if (!account.expires_at) { %>
      <p class="client-line">Tu suscripción no tiene fecha de caducidad.<% if (plan) { %> Plan <strong><%= plan.name %></strong><% } %></p>
    <% } else if (account.status === 'active') { %>
      <%- include('../partials/meter', { days: days, duration: plan ? plan.duration_days : null }) %>
      <p class="client-line">Tu suscripción vence el <strong><%= account.expires_at.slice(0, 10) %></strong><% if (plan) { %> · Plan <strong><%= plan.name %></strong><% } %></p>
    <% } else { %>
      <p class="client-line">Tu suscripción venció el <strong><%= account.expires_at.slice(0, 10) %></strong></p>
    <% } %>
    <% if (account.status !== 'active') { %>
      <div class="flash flash-error">Tu cuenta ha caducado. Contacta con tu proveedor para renovarla.</div>
    <% } else if (account.expires_at && days != null && days <= 7) { %>
      <div class="flash flash-error">Tu cuenta caduca en <%= days %> día<%= days === 1 ? '' : 's' %>. Contacta con tu proveedor para renovarla.</div>
    <% } %>
  </div>
</div>

<% if (account.provision_error) { %>
  <div class="flash flash-error">Tu acceso todavía se está preparando. Si te falta algún servicio, escribe a tu proveedor.</div>
<% } %>

<% if (account.emby_user_id) { %>
<section class="panel">
  <div class="panel-head"><h2>Conéctate a Emby</h2></div>
  <table class="kv">
    <tr><th>Servidor</th><td><code><%= embyUrl %></code></td></tr>
    <tr><th>Puerto</th><td class="td-dim">dejar vacío</td></tr>
    <tr><th>Usuario</th><td><code><%= account.username %></code></td></tr>
    <tr><th>Contraseña</th><td class="td-dim">la que te dio tu proveedor</td></tr>
    <% if (plan && plan.screens) { %>
      <tr><th>Pantallas</th><td><%= plan.screens %> reproducción<%= plan.screens === 1 ? '' : 'es' %> a la vez</td></tr>
    <% } %>
  </table>
  <p class="hint">Descarga la app de Emby en tu televisor, móvil u ordenador e introduce estos datos.</p>
</section>
<% } %>

<% const hotOn = account.player_kind === 'hotplayer' || account.hotplayer_mac; %>
<% const maxOn = account.maxplayer_user_id || account.player_kind === 'maxplayer'; %>
<% if (account.xui_line_id && !maxOn && !hotOn) { %>
<section class="panel">
  <div class="panel-head"><h2>TotalFlix</h2></div>
  <table class="kv">
    <% if (xuiPublicUrl) { %><tr><th>Servidor</th><td><code><%= xuiPublicUrl %></code></td></tr><% } %>
    <tr><th>Usuario</th><td><code><%= account.username %></code></td></tr>
    <tr><th>Contraseña</th><td class="td-dim">la que te dio tu proveedor</td></tr>
    <% if (account.xui_package_name) { %><tr><th>Paquete</th><td><%= account.xui_package_name %></td></tr><% } %>
  </table>
  <p class="hint">Esos datos sirven en la app IPTV o en la lista M3U que te envió tu proveedor.</p>
</section>
<% } %>
<% if (hotOn) { %>
<section class="panel">
  <div class="panel-head"><h2>HotPlayer</h2></div>
  <p class="hint">La lista ya está cargada en tu tele. Abre la app HotPlayer y reproduce. No hace falta poner servidor, usuario ni contraseña.</p>
</section>
<% } %>

<% if (account.maxplayer_user_id) { %>
<section class="panel">
  <div class="panel-head"><h2>Max Player</h2></div>
  <table class="kv">
    <tr><th>Usuario</th><td><code><%= account.username %></code></td></tr>
    <tr><th>Contraseña</th><td class="td-dim">la que te dio tu proveedor</td></tr>
  </table>
  <p class="hint">Abre la app Max Player e inicia sesión. La lista ya está cargada.</p>
</section>
<% } %>

<%- include('../partials/footer') %>

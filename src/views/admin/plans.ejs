<%- include('../partials/header', { title: 'Planes', nav: 'planes' }) %>

<%
// Para precargar el editor: elige la unidad más natural según los días guardados
function unitFor(days) {
  if (days < 1) return { value: Math.round(days * 24), unit: 'horas' };
  if (days % 30 === 0 && days >= 60) return { value: days / 30, unit: 'meses' };
  return { value: days, unit: 'dias' };
}
%>

<section class="panel">
  <div class="panel-head"><h2>Nuevo plan</h2></div>
  <form method="post" action="/admin/planes" class="form-row form-fields">
    <div class="field grow">
      <label for="np-name">Nombre del plan</label>
      <input id="np-name" type="text" name="name" placeholder="ej. Mensual · 1 pantalla" required>
    </div>
    <div class="field">
      <label for="np-dur">Duración</label>
      <div class="duo">
        <input id="np-dur" type="number" name="duration_value" min="1" step="1" value="1" required>
        <select name="duration_unit" aria-label="Unidad de duración">
          <option value="horas">horas</option>
          <option value="dias">días</option>
          <option value="meses" selected>meses</option>
        </select>
      </div>
    </div>
    <div class="field">
      <label for="np-cost">Coste Emby</label>
      <input id="np-cost" type="number" name="credit_cost" min="0" value="1" required>
    </div>
    <div class="field">
      <label for="np-scr">Pantallas</label>
      <input id="np-scr" type="number" name="screens" min="1" max="10" value="1" required>
    </div>
    <div class="field">
      <label for="np-xui">Coste XUI</label>
      <input id="np-xui" type="number" name="xui_credit_cost" min="0" value="0" required>
    </div>
    <div class="field">
      <label for="np-max">Extra Max Player</label>
      <input id="np-max" type="number" name="maxplayer_credit_cost" min="0" value="0" required>
    </div>
    <div class="field field-btn">
      <button class="btn btn-primary">Crear plan</button>
    </div>
  </form>
  <p class="hint">Emby cobra el coste de siempre. XUI se suma al crear la línea, salvo que el paquete tenga un precio propio. Max Player es un extra encima de XUI. 0 significa que ese servicio no gasta créditos.</p>
</section>

<section class="panel">
  <div class="panel-head"><h2>Catálogo <span class="count"><%= plans.length %></span></h2></div>
  <% if (plans.length === 0) { %>
    <p class="empty">No hay planes. Crea al menos uno para poder dar de alta cuentas.</p>
  <% } else { %>
  <table>
    <thead><tr><th>Plan</th><th>Duración</th><th>Emby</th><th>XUI</th><th>Max Player</th><th>Pantallas</th><th>Estado</th><th>Acciones</th></tr></thead>
    <tbody>
    <% plans.forEach(p => { const u = unitFor(p.duration_days); %>
      <tr>
        <td class="td-strong"><%= p.name %></td>
        <td><%= formatDuration(p.duration_days) %></td>
        <td><span class="chip-soft"><%= p.credit_cost %> cr.</span></td>
        <td><span class="chip-soft"><%= p.xui_credit_cost || 0 %> cr.</span></td>
        <td><span class="chip-soft"><%= p.maxplayer_credit_cost || 0 %> cr.</span></td>
        <td><%= p.screens %></td>
        <td>
          <% if (p.is_active) { %><span class="badge badge-ok">activo</span>
          <% } else { %><span class="badge badge-err">retirado</span><% } %>
        </td>
        <td class="actions">
          <details>
            <summary>Editar</summary>
            <form method="post" action="/admin/planes/<%= p.id %>/editar" class="form-stack form-fields">
              <div class="pop-title">Editando «<%= p.name %>»</div>
              <div class="field">
                <label for="ep-name-<%= p.id %>">Nombre del plan</label>
                <input id="ep-name-<%= p.id %>" type="text" name="name" value="<%= p.name %>" required>
              </div>
              <div class="field">
                <label for="ep-dur-<%= p.id %>">Duración</label>
                <div class="duo">
                  <input id="ep-dur-<%= p.id %>" type="number" name="duration_value" min="1" step="1" value="<%= u.value %>" required>
                  <select name="duration_unit" aria-label="Unidad de duración">
                    <option value="horas" <%= u.unit === 'horas' ? 'selected' : '' %>>horas</option>
                    <option value="dias" <%= u.unit === 'dias' ? 'selected' : '' %>>días</option>
                    <option value="meses" <%= u.unit === 'meses' ? 'selected' : '' %>>meses</option>
                  </select>
                </div>
              </div>
              <div class="field">
                <label for="ep-cost-<%= p.id %>">Coste Emby</label>
                <input id="ep-cost-<%= p.id %>" type="number" name="credit_cost" value="<%= p.credit_cost %>" min="0" required>
              </div>
              <div class="field">
                <label for="ep-scr-<%= p.id %>">Pantallas</label>
                <input id="ep-scr-<%= p.id %>" type="number" name="screens" value="<%= p.screens %>" min="1" max="10" required>
              </div>
              <div class="field">
                <label for="ep-xui-<%= p.id %>">Coste XUI</label>
                <input id="ep-xui-<%= p.id %>" type="number" name="xui_credit_cost" value="<%= p.xui_credit_cost || 0 %>" min="0" required>
              </div>
              <div class="field">
                <label for="ep-max-<%= p.id %>">Extra Max Player</label>
                <input id="ep-max-<%= p.id %>" type="number" name="maxplayer_credit_cost" value="<%= p.maxplayer_credit_cost || 0 %>" min="0" required>
              </div>
              <button class="btn btn-primary btn-sm">Guardar cambios</button>
            </form>
          </details>
          <form method="post" action="/admin/planes/<%= p.id %>/toggle" class="inline">
            <button class="btn btn-ghost btn-sm"><%= p.is_active ? 'Retirar' : 'Reactivar' %></button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</section>

<section class="panel">
  <div class="panel-head">
    <h2>Paquetes XUI <span class="count"><%= packages.length %></span></h2>
    <% if (xuiConfigured) { %>
      <form method="post" action="/admin/paquetes/sync" class="inline">
        <button class="btn btn-primary btn-sm">Actualizar desde XUI</button>
      </form>
    <% } %>
  </div>
  <% if (!xuiConfigured) { %>
    <p class="empty">XUI no está configurado. Cuando pongas XUI_API_URL y XUI_API_KEY, aquí podrás traer los paquetes y ponerles precio.</p>
  <% } else if (packages.length === 0) { %>
    <p class="empty">Todavía no hay paquetes guardados. Pulsa «Actualizar desde XUI».</p>
  <% } else { %>
  <table>
    <thead><tr><th>Paquete</th><th>Tipo</th><th>Conexiones</th><th>Precio en créditos</th></tr></thead>
    <tbody>
    <% packages.forEach(pack => { %>
      <tr>
        <td class="td-strong"><%= pack.package_name %></td>
        <td><% if (pack.is_trial) { %><span class="badge badge-warn">prueba</span><% } else { %><span class="badge badge-ok">oficial</span><% } %></td>
        <td><%= pack.max_connections || '—' %></td>
        <td>
          <form method="post" action="/admin/paquetes/coste" class="form-row pack-cost">
            <input type="hidden" name="package_id" value="<%= pack.id %>">
            <input type="number" name="credit_cost" min="0" value="<%= pack.credit_cost == null ? '' : pack.credit_cost %>" placeholder="plan" aria-label="Créditos del paquete <%= pack.package_name %>">
            <button class="btn btn-sm">Guardar</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <p class="hint">Vacío = al crear la línea se cobra el coste XUI del plan. Un número sustituye ese coste. El extra de Max Player del plan se suma aparte.</p>
  <% } %>
</section>

<%- include('../partials/footer') %>

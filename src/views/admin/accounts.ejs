<%- include('../partials/header', { title: 'Cuentas', nav: 'cuentas' }) %>

<%- include('../partials/create-account', {
  formAction: '/admin/cuentas',
  emptyPlans: 'No hay planes activos. <a href="/admin/planes">Crea uno primero</a>.'
}) %>

<section class="panel">
  <div class="panel-head">
    <h2>Todas las cuentas <span class="count"><%= list.length %></span></h2>
    <form method="get" action="/admin/cuentas" class="filter-row">
      <input type="search" name="q" value="<%= q %>" placeholder="Buscar cuenta o reseller" aria-label="Buscar">
      <select name="estado" aria-label="Estado">
        <option value="">Todas</option>
        <option value="active" <%= estado === 'active' ? 'selected' : '' %>>Activas</option>
        <option value="expired" <%= estado === 'expired' ? 'selected' : '' %>>Caducadas</option>
      </select>
      <select name="servicio" aria-label="Servicio">
        <option value="">Todos los servicios</option>
        <option value="emby" <%= servicio === 'emby' ? 'selected' : '' %>>Emby</option>
        <option value="xui" <%= servicio === 'xui' ? 'selected' : '' %>>XUI</option>
        <option value="maxplayer" <%= servicio === 'maxplayer' ? 'selected' : '' %>>Max Player</option>
        <option value="totalflix" <%= servicio === 'totalflix' ? 'selected' : '' %>>TotalFlix</option>
      </select>
      <select name="dominio" aria-label="Servidor Max Player">
        <option value="">Cualquier servidor</option>
        <option value="pato" <%= dominio === 'pato' ? 'selected' : '' %>>PATO</option>
        <option value="cisne" <%= dominio === 'cisne' ? 'selected' : '' %>>CISNE</option>
      </select>
      <button class="btn">Filtrar</button>
    </form>
    <form method="post" action="/admin/cuentas/sincronizar-xui" class="inline" onsubmit="return confirm('¿Traer todas las líneas de XUI? No se cobran créditos ni se duplican cuentas.');">
      <button class="btn">Sincronizar XUI</button>
    </form>
  </div>

  <% if (list.length === 0) { %>
    <p class="empty"><%= q || estado || servicio || dominio ? 'Ninguna cuenta coincide con el filtro.' : 'No hay cuentas todavía. Crea la primera arriba.' %></p>
  <% } else { %>
  <table>
    <thead><tr><th>Cuenta</th><th>Servicios</th><th>Reseller</th><th>Plan</th><th>Creada</th><th>Vence</th><th class="th-meter">Tiempo restante</th><th>Estado</th><th>Acciones</th></tr></thead>
    <tbody>
    <% list.forEach(a => { const d = daysLeft(a.expires_at); %>
      <tr>
        <td class="td-strong"><a href="/admin/cuentas/<%= a.id %>"><%= a.username %></a><% if (a.notes) { %><span class="td-note" title="<%= a.notes %>"><%= a.notes %></span><% } %><% if (a.provision_error) { %><span class="td-note td-warn" title="<%= a.provision_error %>"><%= a.provision_error %></span><% } %></td>
        <td><%- include('../partials/service-badges', { a: a }) %></td>
        <td><%= a.owner %></td>
        <td class="td-dim"><%= a.plan || '—' %></td>
        <td class="td-dim"><%= a.created_at.slice(0, 10) %></td>
        <td><%= a.expires_at.slice(0, 10) %></td>
        <td class="td-meter">
          <% if (a.status === 'active') { %>
            <%- include('../partials/meter', { days: d, duration: a.duration_days }) %>
            <span class="meter-days"><%= d < 0 ? 'hace ' + (-d) + ' d' : d === 0 ? 'hoy' : d + ' d' %></span>
          <% } else { %><span class="td-dim">—</span><% } %>
        </td>
        <td>
          <% if (a.status === 'active' && d < 0) { %><span class="badge badge-err">venció hace <%= -d %> d</span>
          <% } else if (a.status === 'active' && d === 0) { %><span class="badge badge-warn">vence hoy</span>
          <% } else if (a.status === 'active' && d <= 7) { %><span class="badge badge-warn">caduca pronto</span>
          <% } else if (a.status === 'active') { %><span class="badge badge-ok">activa</span>
          <% } else { %><span class="badge badge-err">caducada</span><% } %>
        </td>
        <td class="actions">
          <% if (a.provision_error || (a.player_kind && !a.xui_line_id) || (a.player_kind === 'maxplayer' && !a.maxplayer_user_id) || (a.has_emby && !a.emby_user_id)) { %>
            <form method="post" action="/admin/cuentas/<%= a.id %>/reintentar" class="inline">
              <button class="btn btn-primary btn-sm" title="<%= a.provision_error || 'Completar servicios pendientes' %>">Reintentar</button>
            </form>
          <% } %>
          <a class="btn btn-ghost btn-sm" href="/admin/cuentas/<%= a.id %>/datos" title="Ver y copiar los datos de conexión">Datos</a>
          <details>
            <summary>Renovar</summary>
            <form method="post" action="/admin/cuentas/<%= a.id %>/renovar" class="form-stack">
              <select name="plan_id" required aria-label="Plan de renovación">
                <% plans.forEach(p => { %>
                  <option value="<%= p.id %>" <%= p.id === a.plan_id ? 'selected' : '' %>><%= p.name %> · +<%= formatDuration(p.duration_days) %> · <%= p.credit_cost %> cr.</option>
                <% }) %>
              </select>
              <button class="btn btn-primary btn-sm">Renovar cuenta</button>
            </form>
          </details>
          <details>
            <summary>Plan</summary>
            <form method="post" action="/admin/cuentas/<%= a.id %>/plan" class="form-stack">
              <div class="pop-title">Cambiar plan de «<%= a.username %>»</div>
              <select name="plan_id" required aria-label="Nuevo plan">
                <% plans.forEach(p => { if (p.id !== a.plan_id) { %>
                  <option value="<%= p.id %>"><%= p.name %> · <%= p.screens %> pant. · <%= p.credit_cost %> cr.</option>
                <% } }) %>
              </select>
              <p class="hint">No cambia la fecha. En Emby aplica las pantallas. En XUI, solo si el paquete no fija las conexiones.</p>
              <button class="btn btn-primary btn-sm">Cambiar plan</button>
            </form>
          </details>
          <details>
            <summary>Contraseña</summary>
            <form method="post" action="/admin/cuentas/<%= a.id %>/password" class="form-stack">
              <input type="password" name="password" placeholder="nueva contraseña" required aria-label="Nueva contraseña">
              <button class="btn btn-sm">Cambiar contraseña</button>
            </form>
          </details>
          <%- include('../partials/repair-button', { a: a, repairAction: '/admin/cuentas' }) %>
          <a class="btn btn-ghost btn-sm" href="/admin/cuentas/<%= a.id %>">Ficha</a>
          <details>
            <summary>Mover</summary>
            <form method="post" action="/admin/cuentas/<%= a.id %>/mover" class="form-stack">
              <div class="pop-title">Mover «<%= a.username %>» a:</div>
              <select name="owner_id" required aria-label="Nuevo reseller">
                <% owners.forEach(o => { if (o.username !== a.owner) { %>
                  <option value="<%= o.id %>"><%= o.username %><%= o.role === 'admin' ? ' (admin)' : '' %></option>
                <% } }) %>
              </select>
              <button class="btn btn-primary btn-sm">Mover cuenta</button>
            </form>
          </details>
          <form method="post" action="/admin/cuentas/<%= a.id %>/borrar" class="inline"
                onsubmit="return confirm('¿Borrar <%= a.username %> en todos los servicios donde exista (Emby, XUI, Max Player)?')">
            <button class="btn btn-danger btn-sm">Borrar</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</section>

<%- include('../partials/welcome-modal') %>
<%- include('../partials/footer') %>

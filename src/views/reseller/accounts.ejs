<%- include('../partials/header', { title: 'Mis cuentas', nav: 'cuentas' }) %>

<%- include('../partials/create-account', {
  formAction: '/reseller/cuentas',
  emptyPlans: 'No hay planes disponibles. Contacta con el administrador.'
}) %>

<section class="panel">
  <div class="panel-head">
    <h2>Cartera <span class="count"><%= total %></span></h2>
  </div>
  <div class="list-toolbar">
    <%- include('../partials/account-filters', { filterAction: '/reseller/cuentas', searchPlaceholder: 'Buscar cuenta' }) %>
  </div>

  <% const planHint = 'Solo entre planes de la misma duración; se cobra o devuelve la diferencia de los servicios que ya tiene. No cambia la fecha.'; %>
  <% if (list.length === 0) { %>
    <p class="empty"><%= q || estado || servicio || dominio || tipo ? 'Ninguna cuenta coincide con el filtro.' : 'Aún no has creado ninguna cuenta. Da de alta la primera arriba.' %></p>
  <% } else { %>
  <%- include('../partials/account-list', { actionBase: '/reseller/cuentas', canMove: false, showOwner: false, planHint: planHint }) %>
  <% } %>
</section>

<%- include('../partials/welcome-modal') %>
<%- include('../partials/footer') %>

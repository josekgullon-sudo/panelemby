<span class="svc-badges">
  <% dueServices(account).forEach(function (name) { %>
    <% if (name === 'XUI') { %>
      <span class="svc-with-sub">
        <span class="badge svc-xui">XUI</span>
        <% const isMax = account.player_kind === 'maxplayer' || account.maxplayer_user_id; %>
        <% const isHot = account.player_kind === 'hotplayer' || account.hotplayer_mac; %>
        <span class="svc-sub"><%= isMax && isHot ? 'Max Player · HotPlayer' : isMax ? 'Max Player' : isHot ? 'HotPlayer' : 'TotalFlix' %></span>
        <% if (isHot && account.hotplayer_mac) { %><span class="svc-mac"><%= account.hotplayer_mac %></span><% } %>
      </span>
    <% } else { %>
      <span class="badge svc-emby">Emby</span>
    <% } %>
  <% }) %>
  <% if (account.is_trial) { %><span class="badge badge-warn">Prueba</span><% } %>
</span>

<form method="get" action="<%= filterAction %>" class="filter-row">
  <label class="filter-field">Buscar
    <input type="search" name="q" value="<%= q %>" placeholder="<%= searchPlaceholder %>" aria-label="Buscar">
  </label>
  <label class="filter-field">Estado
    <select name="estado" aria-label="Estado">
      <option value="">Todos</option>
      <option value="active" <%= estado === 'active' ? 'selected' : '' %>>Activas</option>
      <option value="expired" <%= estado === 'expired' ? 'selected' : '' %>>Caducadas</option>
    </select>
  </label>
  <label class="filter-field">Tipo
    <select name="tipo" aria-label="Tipo">
      <option value="">Prueba y normal</option>
      <option value="prueba" <%= tipo === 'prueba' ? 'selected' : '' %>>Prueba</option>
      <option value="normal" <%= tipo === 'normal' ? 'selected' : '' %>>Normal</option>
    </select>
  </label>
  <% if (showReseller) { %>
  <label class="filter-field">Revendedor
    <select name="reseller" aria-label="Revendedor">
      <option value="">Todos</option>
      <% owners.forEach(function (o) { %>
        <option value="<%= o.id %>" <%= String(reseller) === String(o.id) ? 'selected' : '' %>><%= o.username %><%= o.role === 'admin' ? ' (admin)' : '' %></option>
      <% }) %>
    </select>
  </label>
  <% } %>
  <button class="btn btn-primary">Buscar</button>
</form>

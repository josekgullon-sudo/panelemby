<article class="account-card">
  <div class="account-card-top">
    <a class="account-name" href="<%= actionBase %>/<%= a.id %>"><%= a.username %></a>
    <%- include('./account-status', { a: a, d: d }) %>
  </div>
  <div class="account-card-badges"><%- include('./service-badges', { a: a }) %></div>
  <% if (a.notes) { %><p class="account-note"><%= a.notes %></p><% } %>
  <% if (a.provision_error) { %><p class="account-note is-warn"><%= a.provision_error %></p><% } %>
  <dl class="account-meta">
    <% if (showOwner) { %>
      <div><dt>Reseller</dt><dd><%= a.owner %></dd></div>
    <% } %>
    <div><dt>Plan</dt><dd><%= a.plan || '—' %></dd></div>
    <div><dt>Vence</dt><dd><%= a.expires_at.slice(0, 10) %></dd></div>
    <div class="account-meta-time">
      <dt>Tiempo restante</dt>
      <dd>
        <% if (a.status === 'active') { %>
          <%- include('./meter', { days: d, duration: a.duration_days }) %>
          <span class="meter-days"><%= d < 0 ? 'hace ' + (-d) + ' d' : d === 0 ? 'hoy' : d + ' d' %></span>
        <% } else { %><span class="td-dim">—</span><% } %>
      </dd>
    </div>
  </dl>
  <div class="account-card-bar">
    <details class="more-menu">
      <summary aria-label="Más acciones"><span aria-hidden="true">⋯</span></summary>
      <div class="more-panel actions">
        <%- include('./account-actions', { a: a, actionBase: actionBase, canMove: canMove, planHint: planHint, menu: true }) %>
      </div>
    </details>
    <form method="post" action="<%= actionBase %>/<%= a.id %>/borrar"
          onsubmit="return confirm('¿Borrar <%= a.username %> en todos los servicios donde exista (Emby, XUI, Max Player)?')">
      <button class="btn btn-danger">Borrar</button>
    </form>
  </div>
</article>

<% if (a.status !== 'active') { %><span class="badge badge-err">caducada</span>
<% } else if (d == null) { %><span class="badge badge-ok">activa</span>
<% } else if (d < 0) { %><span class="badge badge-err">venció hace <%= -d %> d</span>
<% } else if (d === 0) { %><span class="badge badge-warn">vence hoy</span>
<% } else if (d <= 7) { %><span class="badge badge-warn">caduca pronto</span>
<% } else { %><span class="badge badge-ok">activa</span><% } %>

<% if (a.provision_error || (a.player_kind && !a.xui_line_id) || (a.player_kind === 'maxplayer' && !a.maxplayer_user_id) || (a.has_emby && !a.emby_user_id)) { %>
  <form method="post" action="<%= actionBase %>/<%= a.id %>/reintentar" class="inline">
    <button class="btn btn-primary btn-sm" title="<%= a.provision_error || 'Completar servicios pendientes' %>">Reintentar</button>
  </form>
<% } %>
<a class="btn btn-ghost btn-sm" href="<%= actionBase %>/<%= a.id %>/datos" title="Ver y copiar los datos de conexión">Datos</a>
<details>
  <summary>Renovar</summary>
  <form method="post" action="<%= actionBase %>/<%= a.id %>/renovar" class="form-stack">
    <select name="plan_id" required aria-label="Plan de renovación">
      <% plans.forEach(p => { %>
        <option value="<%= p.id %>" <%= p.id === a.plan_id ? 'selected' : '' %>><%= p.name %> · +<%= formatDuration(p.duration_days) %> · <%= p.credit_cost %> cr.</option>
      <% }) %>
    </select>
    <button class="btn btn-primary btn-sm">Renovar cuenta</button>
  </form>
</details>
<details>
  <summary>Plan</summary>
  <form method="post" action="<%= actionBase %>/<%= a.id %>/plan" class="form-stack">
    <div class="pop-title">Cambiar plan de «<%= a.username %>»</div>
    <select name="plan_id" required aria-label="Nuevo plan">
      <% plans.forEach(p => { if (p.id !== a.plan_id) { %>
        <option value="<%= p.id %>"><%= p.name %> · <%= p.screens %> pant. · <%= p.credit_cost %> cr.</option>
      <% } }) %>
    </select>
    <p class="hint"><%= planHint %></p>
    <button class="btn btn-primary btn-sm">Cambiar plan</button>
  </form>
</details>
<details>
  <summary>Contraseña</summary>
  <form method="post" action="<%= actionBase %>/<%= a.id %>/password" class="form-stack">
    <input type="password" name="password" placeholder="nueva contraseña" required aria-label="Nueva contraseña">
    <button class="btn btn-sm">Cambiar contraseña</button>
  </form>
</details>
<%- include('./repair-button', { a: a, repairAction: actionBase }) %>
<a class="btn btn-ghost btn-sm" href="<%= actionBase %>/<%= a.id %>">Ficha</a>
<% if (canMove) { %>
<details>
  <summary>Mover</summary>
  <form method="post" action="<%= actionBase %>/<%= a.id %>/mover" class="form-stack">
    <div class="pop-title">Mover «<%= a.username %>» a:</div>
    <select name="owner_id" required aria-label="Nuevo reseller">
      <% owners.forEach(o => { if (o.username !== a.owner) { %>
        <option value="<%= o.id %>"><%= o.username %><%= o.role === 'admin' ? ' (admin)' : '' %></option>
      <% } }) %>
    </select>
    <button class="btn btn-primary btn-sm">Mover cuenta</button>
  </form>
</details>
<% } %>
<% if (!menu) { %>
<form method="post" action="<%= actionBase %>/<%= a.id %>/borrar" class="inline"
      onsubmit="return confirm('¿Borrar <%= a.username %> en todos los servicios donde exista (Emby, XUI, Max Player)?')">
  <button class="btn btn-danger btn-sm">Borrar</button>
</form>
<% } %>

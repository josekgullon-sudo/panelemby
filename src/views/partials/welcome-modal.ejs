<% if (newAccount) { const resend = newAccount.mode === 'resend'; %>
<dialog class="modal" id="welcome-modal" aria-labelledby="welcome-title">
  <div class="modal-head">
    <h3 id="welcome-title"><%= resend ? 'Datos de conexión · ' + newAccount.username : 'Cuenta creada' %></h3>
    <% if (newAccount.provisionError) { %><span class="badge badge-warn">incompleta</span>
    <% } else { %><span class="badge badge-ok">lista para enviar</span><% } %>
  </div>
  <p class="modal-sub">Copia este mensaje y pégaselo a tu cliente:</p>
  <pre class="welcome-text" id="welcome-text"><%= newAccount.message %></pre>
  <script type="application/json" id="welcome-copy"><%- JSON.stringify(newAccount.message || '').replace(/</g, '\\u003c') %></script>
  <% if (resend && !newAccount.password) { %>
    <p class="hint">La contraseña de esta cuenta no está guardada en el panel (es anterior a esta función). Si el cliente la perdió, usa «Contraseña» para ponerle una nueva: a partir de ahí quedará disponible aquí.</p>
  <% } %>
  <% if (newAccount.provisionError) { %>
    <p class="hint hint-warn"><%= newAccount.provisionError %></p>
  <% } %>
  <div class="modal-actions">
    <button type="button" class="btn btn-primary" id="copy-welcome">Copiar</button>
    <form method="dialog"><button class="btn">Cerrar</button></form>
  </div>
</dialog>
<script>
(function () {
  var d = document.getElementById('welcome-modal');
  if (d && d.showModal) d.showModal();
  var b = document.getElementById('copy-welcome');
  function done() {
    b.textContent = '¡Copiado!';
    setTimeout(function () { b.textContent = 'Copiar'; }, 1800);
  }
  b.addEventListener('click', function () {
    var raw = document.getElementById('welcome-copy');
    var t = raw ? JSON.parse(raw.textContent) : document.getElementById('welcome-text').textContent;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(t).then(done, fallback);
    } else {
      fallback();
    }
    function fallback() {
      var area = document.createElement('textarea');
      area.value = t;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.left = '-9999px';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      document.body.removeChild(area);
      done();
    }
  });
})();
</script>
<% } %>
